        "users_telegram_id_positive": {
          "name": "users_telegram_id_positive",
          "value": "\"users\".\"telegram_id\" > 0"
        },
        "users_public_id_format": {
          "name": "users_public_id_format",
          "value": "\"users\".\"public_id\" ~ '^[0-9A-HJKMNP-TV-Z]{10}$'"
        },
        "users_mode_band": {
          "name": "users_mode_band",
          "value": "\"users\".\"mode\" IS NULL OR \"users\".\"mode\" = 'friends' OR coalesce(\"users\".\"age_band\" = 'adult', false)"
        },
        "users_username_adult": {
          "name": "users_username_adult",
          "value": "\"users\".\"username\" IS NULL OR coalesce(\"users\".\"age_band\" = 'adult', false)"
        },
        "users_mode_needs_band": {
          "name": "users_mode_needs_band",
          "value": "\"users\".\"mode\" IS NULL OR \"users\".\"age_band\" IS NOT NULL"
        },
        "users_band_needs_birth_date": {
          "name": "users_band_needs_birth_date",
          "value": "\"users\".\"age_band\" IS NULL OR \"users\".\"birth_date\" IS NOT NULL"
        },
        "users_dating_fields": {
          "name": "users_dating_fields",
          "value": "coalesce(\"users\".\"mode\" = 'dating', false) = (\"users\".\"gender\" IS NOT NULL AND \"users\".\"seeking\" IS NOT NULL)"
        },
        "users_seeking_not_empty": {
          "name": "users_seeking_not_empty",
          "value": "\"users\".\"seeking\" IS NULL OR cardinality(\"users\".\"seeking\") >= 1"
        },
        "users_dating_age_range": {
          "name": "users_dating_age_range",
          "value": "CASE WHEN coalesce(\"users\".\"mode\" = 'dating', false)\n        THEN \"users\".\"dating_age_min\" IS NOT NULL AND \"users\".\"dating_age_max\" IS NOT NULL AND \"users\".\"dating_age_min\" >= 18 AND \"users\".\"dating_age_min\" <= \"users\".\"dating_age_max\" AND \"users\".\"dating_age_max\" <= 120\n        ELSE \"users\".\"dating_age_min\" IS NULL AND \"users\".\"dating_age_max\" IS NULL END"
        },
        "users_ineligible_minimal": {
          "name": "users_ineligible_minimal",
          "value": "\"users\".\"status\" <> 'ineligible' OR (\"users\".\"mode\" IS NULL AND \"users\".\"gender\" IS NULL AND \"users\".\"seeking\" IS NULL AND \"users\".\"username\" IS NULL AND \"users\".\"timezone\" IS NULL AND \"users\".\"onboarded_at\" IS NULL)"
        }
      },
