{
  "name": "@samesync/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/main.ts",
    "start": "node --env-file-if-exists=../../.env dist/main.js",
    "build": "node build.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "db:migrate": "tsx --env-file-if-exists=../../.env scripts/migrate.ts",
    "db:generate": "drizzle-kit generate",
    "dev:initdata": "tsx --env-file-if-exists=../../.env scripts/dev-initdata.ts",
    "dev:population": "tsx --env-file-if-exists=../../.env scripts/dev-population.ts",
    "dev:match-me": "tsx --env-file-if-exists=../../.env scripts/dev-match-me.ts",
    "dev:say": "tsx --env-file-if-exists=../../.env scripts/dev-say.ts",
    "dev:reveal": "tsx --env-file-if-exists=../../.env scripts/dev-reveal.ts",
    "bench:matching": "tsx --env-file-if-exists=../../.env scripts/bench-matching.ts",
    "content:seed": "tsx --env-file-if-exists=../../.env scripts/seed-content.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.3",
    "@samesync/content": "workspace:*",
    "@samesync/shared": "workspace:*",
    "drizzle-orm": "^0.45.3",
    "grammy": "^1.46.0",
    "hono": "^4.13.12",
    "pg": "^8.23.1",
    "pino": "~10.3.1",
    "uuid": "^14.0.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "fast-check": "^4.10.2",
    "tsx": "^4.23.15"
  }
}
