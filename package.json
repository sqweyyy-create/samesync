{
  "name": "samesync",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": "^24"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @samesync/server --filter @samesync/miniapp run dev",
    "dev:up": "pnpm --filter @samesync/server run dev:up",
    "dev:down": "pnpm --filter @samesync/server run dev:down",
    "dev:scenario": "pnpm --filter @samesync/server run dev:scenario",
    "dev:initdata": "pnpm --filter @samesync/server run dev:initdata",
    "dev:population": "pnpm --filter @samesync/server run dev:population",
    "dev:match-me": "pnpm --filter @samesync/server run dev:match-me",
    "dev:say": "pnpm --filter @samesync/server run dev:say",
    "dev:reveal": "pnpm --filter @samesync/server run dev:reveal",
    "bench:matching": "pnpm --filter @samesync/server run bench:matching",
    "db:migrate": "pnpm --filter @samesync/server run db:migrate",
    "db:generate": "pnpm --filter @samesync/server run db:generate",
    "build": "pnpm --recursive run build",
    "lint": "eslint . --max-warnings=0 && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc -p tsconfig.json && pnpm --recursive run typecheck",
    "test": "vitest run",
    "test:safety": "vitest run --project server-safety",
    "content:check": "pnpm --filter @samesync/content run check",
    "content:lock": "pnpm --filter @samesync/content run lock",
    "content:seed": "pnpm --filter @samesync/server run content:seed"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.0.0",
    "@vitest/eslint-plugin": "^1.6.27",
    "eslint": "~10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  }
}
