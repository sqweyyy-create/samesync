# Copy to .env and fill in the blanks. .env is gitignored: never commit it.

NODE_ENV=development
LOG_LEVEL=info

# --- Telegram -----------------------------------------------------------------
# Token of your DEV bot from @BotFather.
BOT_TOKEN=
# HTTPS URL that opens the Mini App: your tunnel to the Vite dev server (port 5173).
MINIAPP_URL=https://your-tunnel.trycloudflare.com

# --- HTTP API -----------------------------------------------------------------
HTTP_HOST=127.0.0.1
HTTP_PORT=3000

# --- Auth ---------------------------------------------------------------------
# Oldest initData accepted, and allowed clock skew, in seconds.
INITDATA_MAX_AGE_SEC=86400
INITDATA_CLOCK_SKEW_SEC=60

# --- Safety gates & admins ----------------------------------------------------
# Must stay false in production until release gate G3 (PLAN.md §7). The server refuses to start otherwise.
U18_POOL_ENABLED=false
# Admins (Phase 5): comma-separated Telegram user IDs. They alone get the admin commands in the
# bot (/admin lists them), and they get the alerts (reports that need a look, automatic freezes,
# /support requests). pnpm dev:scenario phase5 prints the line for your own account.
ADMIN_TELEGRAM_IDS=

# --- Local Postgres (docker compose) ------------------------------------------
# Local-only credentials: choose your own values. They are applied when the Docker volume is created.
POSTGRES_USER=samesync_owner
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
APP_DB_PASSWORD=
# Runtime connection, as the restricted app role. Replace the <...> parts.
DATABASE_URL=postgres://samesync_app:<APP_DB_PASSWORD>@127.0.0.1:5432/samesync
# Owner connection, used only by `pnpm db:migrate`.
MIGRATION_DATABASE_URL=postgres://samesync_owner:<POSTGRES_PASSWORD>@127.0.0.1:5432/samesync
# Owner connection to the maintenance DB. Tests create and drop throwaway databases through it.
TEST_DATABASE_URL=postgres://samesync_owner:<POSTGRES_PASSWORD>@127.0.0.1:5432/postgres

# --- Matching -----------------------------------------------------------------
# Drops (Q8): the local times each locale's pools are matched at, and the time zone they are in.
# MATCH_DROP_TIMES_RU=13:00,20:00
# MATCH_DROP_TZ_RU=Europe/Moscow
# MATCH_DROP_TIMES_EN=13:00,20:00
# MATCH_DROP_TZ_EN=UTC
# Free tier (Q27): new matches per rolling 24 hours, and open matches at once.
# MATCH_DAILY_LIMIT=3
# MATCH_OPEN_LIMIT=5

# --- Content ------------------------------------------------------------------
# Folder with the content files. Defaults to the repository's content/ (set it in deployments).
# CONTENT_DIR=

# --- Mini App dev server --------------------------------------------------------
# Hosts Vite accepts (your tunnel's domain). Comma-separated; a leading dot allows subdomains.
MINIAPP_DEV_ALLOWED_HOSTS=.trycloudflare.com
# Base URL printed by `pnpm dev:initdata`.
MINIAPP_DEV_URL=http://localhost:5173
